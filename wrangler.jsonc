{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myrenewlet",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "renewlet.xiler.vip",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myrenewlet",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"]
  }
}
