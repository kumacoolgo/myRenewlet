{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myrenewlet",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "secrets": {
    "required": ["AUTH_USERNAME", "AUTH_PASSWORD"]
  },
  "routes": [
    {
      "pattern": "renewlet.xiler.vip",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myrenewlet",
      "database_id": "6b304275-ac62-4d90-bd81-3b113af8d8cf",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"]
  }
}
